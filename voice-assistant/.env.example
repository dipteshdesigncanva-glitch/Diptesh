# ElevenLabs (server-side only - never expose in the browser)
ELEVENLABS_API_KEY=
# Printed by `npm run create-engine`
ELEVENLABS_SPEECH_ENGINE_ID=
# Public WebSocket URL for this server, e.g. from `ngrok http 3001`
PUBLIC_WS_URL=wss://your-subdomain.ngrok.app/ws

# Anthropic
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

PORT=3001
# DEBUG=true
